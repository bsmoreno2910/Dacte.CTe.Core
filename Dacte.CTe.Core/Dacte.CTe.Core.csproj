<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>

    <!-- Identidade do pacote -->
    <PackageId>Dacte.CTe.Core</PackageId>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>

    <!-- Metadata -->
    <Authors>Bruno Moreno (bsmoreno2910)</Authors>
    <Company>Bruno Moreno</Company>
    <Copyright>Copyright © 2026 Bruno Moreno</Copyright>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Description>Gerador de DACTE (Documento Auxiliar do Conhecimento de Transporte Eletrônico) modelo 57 em PDF a partir do XML do CT-e. Usa PdfSharpCore. Compatível com .NET Standard 2.0 e .NET 8. Suporta os modais rodoviário, aéreo, aquaviário, ferroviário, dutoviário e multimodal.</Description>
    <PackageTags>dacte;cte;cte-os;conhecimento-transporte-eletronico;pdf;pdfsharpcore;brasil;fiscal</PackageTags>
    <PackageReleaseNotes>v1.0.3 - Adiciona modos de ajuste do logo, mantendo o comportamento padrão anterior e oferecendo encaixe proporcional opcional.</PackageReleaseNotes>

    <!-- Links -->
    <PackageProjectUrl>https://github.com/bsmoreno2910/Dacte.CTe.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bsmoreno2910/Dacte.CTe.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Licença -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- README embarcado (aparece na página do pacote no nuget.org) -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Symbols para debug dos consumidores -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
