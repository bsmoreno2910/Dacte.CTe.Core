## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# IDE / agent metadata
.claude/
.codex/
.cursor/
.aider*
.continue/
.github/copilot-*
*.bak

# Build results
bin/
obj/
[Dd]ebug/
[Rr]elease/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NuGet output
*.nupkg
*.snupkg
.vs/

# Visual Studio cache files
*.[Cc]ache

# IDE files
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test results
TestResults/
*.trx
coverage*.xml
*.coverage

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
